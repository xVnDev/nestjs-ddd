{
  "name": "nestjs-ddd",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xVnDev/nestjs-ddd.git"
  },
  "scripts": {
    "test": "vitest run && npm run test:arch",
    "test:arch": "vitest run test/architecture",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "plans:check": "node scripts/check-plan-links.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --fix --type-aware src/ test/",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:cov": "vitest run --config vitest.unit.config.ts --coverage",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "docs:check": "node scripts/check-links.mjs",
    "typeorm": "typeorm -d dist/common/config/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@keyv/redis": "^6.1.0",
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@scalar/nestjs-api-reference": "^1.2.41",
    "argon2": "^0.45.2",
    "axios": "^1.21.1",
    "bullmq": "^6.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "es-toolkit": "^1.53.1",
    "handlebars": "^4.7.10",
    "ioredis": "^6.1.0",
    "joi": "^18.3.2",
    "keyv": "^6.1.0",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@nestjs/mau": {
      "tmp": "^0.2.7",
      "undici": "^8.13.1"
    },
    "typeorm": {
      "ioredis": "^6.1.0"
    },
    "testcontainers": {
      "minimatch": "^11.0.9"
    },
    "@nestjs-modules/mailer": {
      "minimatch": "^11.0.9",
      "glob": "^14.0.6"
    }
  }
}
